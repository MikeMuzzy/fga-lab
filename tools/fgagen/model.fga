model
  schema 1.1

type user

type group
  relations
    define member: [user]

type folder
  relations
    define owner: [user]
    define editor: [user, group#member] with path_match
    define viewer: [user, user:*, group#member]
    define can_write: owner or editor
    define can_read: viewer or can_write

# The pattern is fixed when the grant is written and is authoritative: OpenFGA
# gives tuple context precedence over Check context, so a caller cannot widen it.
# fga:write allowed_pattern
# The path comes from the request being authorized.
# fga:check requested_path
condition path_match(allowed_pattern: string, requested_path: string) {
  requested_path.startsWith(allowed_pattern)
}